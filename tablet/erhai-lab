class LabError(Exception):
    """A refusal or failure with a reason the user should see verbatim."""


def lab_identity(cmdline: str) -> tuple[str, str, str]:
    """(candidate, build, stack) from erhai_lab.* params on a lab UKI's cmdline."""
    cand = build = stack = ""
    for word in cmdline.split():
        if word.startswith("erhai_lab.candidate="):
            cand = word.split("=", 1)[1]
        elif word.startswith("erhai_lab.build="):
            build = word.split("=", 1)[1]
        elif word.startswith("erhai_lab.stack="):
            stack = word.split("=", 1)[1]
    return cand, build, stack


# ----------------------------------------------------------------- fetch ---

def parse_sums(text: str) -> dict[str, str]:
    """sha256sum output -> {filename: hexdigest}."""
    sums: dict[str, str] = {}
    for n, line in enumerate(text.splitlines(), 1):
        if not line.strip():
            continue
        m = re.fullmatch(r"([0-9a-f]{64}) [ *](.+)", line.strip())
        if not m:
            raise LabError(f"SHA256SUMS line {n} is malformed: {line!r}")
        sums[m.group(2)] = m.group(1)
    if not sums:
        raise LabError("SHA256SUMS is empty")
    return sums


def sha256_file(path: Path) -> str:
    h = hashlib.sha256()
    with path.open("rb") as f:
        for chunk in iter(lambda: f.read(1 << 20), b""):
            h.update(chunk)
    return h.hexdigest()


def verify_assets(directory: Path) -> None:
    """Every downloaded file must be listed in SHA256SUMS and match it."""
    sums_path = directory / "SHA256SUMS"
    if not sums_path.is_file():
        raise LabError("release has no SHA256SUMS; refusing to install")
    sums = parse_sums(sums_path.read_text())
    present = {p.name for p in directory.iterdir() if p.is_file()} - {"SHA256SUMS"}
    missing = sorted(set(sums) - present)
    if missing:
        raise LabError(f"listed in SHA256SUMS but not downloaded: {missing}")
    unlisted = sorted(present - set(sums))
    if unlisted:
        raise LabError(f"downloaded but not listed in SHA256SUMS: {unlisted}")
    for name, want in sorted(sums.items()):
        got = sha256_file(directory / name)
        if got != want:
            raise LabError(f"checksum mismatch for {name}: {got} != {want}")


@dataclasses.dataclass
class Assets:
    kver: str
    uki: Path
    modules: Path
    config: Path


def identify_assets(directory: Path, candidate: str) -> Assets:
    """One UKI, one modules tarball, one config, all for the same lab kver."""
    names = sorted(p.name for p in directory.iterdir() if p.is_file())
    ukis = [n for n in names if n.endswith(".efi")]
    mods = [n for n in names if n.startswith("modules-") and n.endswith(".tar.zst")]
    cfgs = [n for n in names if n.startswith("config-")]
    if len(ukis) != 1 or len(mods) != 1 or len(cfgs) != 1:
        raise LabError(f"expected one .efi, one modules tarball and one config, got {names}")
    kver = ukis[0][: -len(".efi")]
    if mods[0] != f"modules-{kver}.tar.zst" or cfgs[0] != f"config-{kver}":
        raise LabError(f"UKI {ukis[0]} does not match {mods[0]} / {cfgs[0]}")
    if not kver.endswith(f"-lab-{candidate}"):
        raise LabError(f"kernelrelease {kver} is not a lab build of {candidate}")
    return Assets(kver, directory / ukis[0], directory / mods[0], directory / cfgs[0])


def latest_tag(tags: list[str], candidate: str) -> str:
    """Highest lab-<candidate>-<run> tag."""
    prefix = f"lab-{candidate}-"
    runs = []
    for t in tags:
        if t.startswith(prefix) and t[len(prefix):].isdigit():
            runs.append(int(t[len(prefix):]))
    if not runs:
        raise LabError(f"no release found for candidate {candidate}")
    return f"{prefix}{max(runs)}"


API = "https://api.github.com"


def http_get(url: str, accept: str = "application/vnd.github+json") -> bytes:
    """Anonymous HTTPS GET: the lab repo is public, and fetch runs as root,
    which has no gh login."""
    import urllib.error
    import urllib.request
    req = urllib.request.Request(url, headers={"Accept": accept,
                                               "User-Agent": "erhai-lab"})
    try:
        with urllib.request.urlopen(req, timeout=60) as r:
            return r.read()
    except urllib.error.HTTPError as e:
        raise LabError(f"GET {url}: HTTP {e.code} {e.reason}") from None
    except urllib.error.URLError as e:
        raise LabError(f"GET {url}: {e.reason}") from None


def release_assets(releases: list[dict], tag: str) -> list[tuple[str, str]]:
    """(name, download url) of every asset of the release tagged `tag`."""
    for r in releases:
        if r.get("tag_name") == tag:
            return [(a["name"], a["browser_download_url"]) for a in r.get("assets", [])]
    raise LabError(f"release {tag} not found")


def install_assets(assets: Assets, boot_dir: Path = BOOT_DIR,
                   modules_dir: Path = MODULES_DIR) -> None:
    """Copy a verified lab kernel beside the package kernel.

    Only ever writes /boot/<lab kver>.efi and /usr/lib/modules/<lab kver>/;
    the package's UKI, its modules and rEFInd's default are never touched.
    """
    if "-lab-" not in assets.kver:
        raise LabError(f"refusing to install non-lab kernelrelease {assets.kver}")
    target = modules_dir / assets.kver
    staging = Path(tempfile.mkdtemp(prefix=".erhai-lab-", dir=modules_dir))
    try:
        subprocess.run(["tar", "--zstd", "-x", "-f", str(assets.modules),
                        "-C", str(staging)], check=True)
        unpacked = staging / assets.kver
        if not unpacked.is_dir():
            raise LabError(f"modules tarball has no {assets.kver}/ directory")
        if target.exists():
            shutil.rmtree(target)
        unpacked.rename(target)
    finally:
        shutil.rmtree(staging, ignore_errors=True)
    tmp_uki = boot_dir / f".{assets.kver}.efi.tmp"
    shutil.copyfile(assets.uki, tmp_uki)
    os.replace(tmp_uki, boot_dir / f"{assets.kver}.efi")
    subprocess.run(["depmod", "-a", assets.kver], check=True)


def find_release(repo: str, candidate: str, tag: str | None,
                 get=http_get) -> tuple[str, list[tuple[str, str]]]:
    """(tag, assets) of the requested or latest release of `candidate`.

    The anonymous release list can come back empty while the releases exist
    (seen 2026-10-23: the list returned [] and /releases/tags/<tag> answered),
    so an explicit tag missing from the list is looked up by tag.
    """
    releases = json.loads(get(f"{API}/repos/{repo}/releases?per_page=100"))
    if not tag:
        if not releases:
            raise LabError("GitHub returned an empty release list; pass "
                           f"--tag lab-{candidate}-<run> (see the repo's Releases page)")
        tag = latest_tag([r["tag_name"] for r in releases], candidate)
    if not any(r.get("tag_name") == tag for r in releases):
        releases = [json.loads(get(f"{API}/repos/{repo}/releases/tags/{tag}"))]
    return tag, release_assets(releases, tag)


def verify_and_install(d: Path, candidate: str, label: str, verify_only: bool) -> int:
    verify_assets(d)
    assets = identify_assets(d, candidate)
    print(f"{label}: verified {assets.kver} ({len(parse_sums((d / 'SHA256SUMS').read_text()))} files)")
    if verify_only:
        return 0
    require_root("fetch")
    install_assets(assets)
    print(f"installed /boot/{assets.kver}.efi and {MODULES_DIR / assets.kver}/")
    print("Pick it in the rEFInd menu on the next boot; the default entry is unchanged.")
    return 0


def cmd_fetch(args: argparse.Namespace) -> int:
    if args.from_dir:
        # A local build (tools/build-local.sh): same checks, no download.
        d = Path(args.from_dir)
        if not d.is_dir():
            raise LabError(f"{d} is not a directory")
        return verify_and_install(d, args.candidate, f"local {d}", args.verify_only)
    tag, assets_list = find_release(args.repo, args.candidate, args.tag)
    with tempfile.TemporaryDirectory(prefix="erhai-lab-fetch-") as tmp:
        d = Path(tmp)
        for name, url in assets_list:
            if "/" in name or name.startswith("."):
                raise LabError(f"refusing asset name {name!r}")
            print(f"  downloading {name}")
            (d / name).write_bytes(http_get(url, "application/octet-stream"))
        return verify_and_install(d, args.candidate, tag, args.verify_only)


def whoami_line() -> str:
    cand, build, stack = lab_identity(PROC_CMDLINE.read_text())
    kver = os.uname().release
    if cand:
        return (f"{kver}: lab candidate {cand}, build {build or '?'}"
                + (f", stack={stack}" if stack else ""))
    return f"{kver}: package kernel (not a lab build)"


def cmd_whoami(args: argparse.Namespace) -> int:
    print(whoami_line())
    return 0


# ----------------------------------------------------------------- setup ---

def helper(name: str) -> Path:
    """Path of an installed helper under LIB_DIR."""
    path = LIB_DIR / name
    if not path.is_file():
        raise LabError(f"{name} not installed; run sudo tablet/install.sh")
    return path


def cmd_setup(args: argparse.Namespace) -> int:
    require_root("setup")
    steps = [("setup.sh", [str(helper("setup.sh"))], None),
             ("igt-recovery build", [str(helper("igt-recovery")), "build"],
              {"IGT_DIR": str(STATE_DIR / "igt")})]
    for step, cmd, extra_env in steps:
        env = {**os.environ, **extra_env} if extra_env else None
        if subprocess.run(cmd, env=env).returncode != 0:
            raise LabError(f"setup step failed: {step}")
    return 0


# ------------------------------------------------------------------ mode ---

MODES = ("once", "always")
_MODE_RE = re.compile(r"^[ \t]*MODE=([^\r\n]*)", re.MULTILINE)
PIN_SERVICE = {"once": "erhai-gpu-pin-once.service", "always": "erhai-gpu-pin.service"}


def read_mode(text: str) -> str:
    """Value of the last uncommented MODE= line."""
    found = _MODE_RE.findall(text)
    if not found:
        raise LabError("no MODE= line in the pin config")
    return found[-1].strip()


def set_mode_text(text: str, mode: str) -> str:
    """text with only the last uncommented MODE= line changed."""
    if mode not in MODES:
        raise LabError(f"unknown mode {mode!r}; use once or always")
    last = None
    for last in _MODE_RE.finditer(text):
        pass
    if last is None:
        raise LabError("no MODE= line in the pin config; refusing to guess")
    return text[:last.start(1)] + mode + text[last.end(1):]


def write_mode(conf: Path, mode: str, run=subprocess.run) -> None:
    """Rewrite MODE= in conf atomically, then align the two pin services.

    MODE=once  <=> erhai-gpu-pin-once.service enabled, erhai-gpu-pin.service disabled;
    MODE=always is the reverse. Nothing is started or stopped: boot-time only."""
    if mode not in MODES:
        raise LabError(f"unknown mode {mode!r}; use once or always")
    tmp = None
    try:
        with open(conf, newline="") as f:  # keep CRLF/no-final-newline as is
            text = f.read()
        new = set_mode_text(text, mode)
        st = conf.stat()
        fd, tmp = tempfile.mkstemp(dir=conf.parent, prefix=f".{conf.name}.")
        with os.fdopen(fd, "w", newline="") as f:
            f.write(new)
            f.flush()
            os.fsync(f.fileno())
        os.chmod(tmp, st.st_mode & 0o7777)
        if os.geteuid() == 0:
            os.chown(tmp, st.st_uid, st.st_gid)
        os.replace(tmp, conf)
        tmp = None
    except OSError as e:
        raise LabError(f"could not rewrite {conf}: {e}") from e
    finally:
        if tmp is not None:
            try:
                os.unlink(tmp)
            except OSError:
                pass
    other = "once" if mode == "always" else "always"
    for action, svc in (("enable", PIN_SERVICE[mode]), ("disable", PIN_SERVICE[other])):
        cmd = ["systemctl", action, svc]
        try:
            rc = run(cmd).returncode
        except OSError as e:
            raise LabError(f"{' '.join(cmd)} could not run: {e}; "
                           f"{conf} is already rewritten to MODE={mode}") from e
        if rc != 0:
            raise LabError(f"{' '.join(cmd)} failed (exit {rc}); "
                           f"{conf} is already rewritten to MODE={mode}")


def cmd_mode(args: argparse.Namespace) -> int:
    require_root("mode")
    try:
        old = read_mode(PIN_CONF.read_text())
    except OSError as e:
        raise LabError(f"cannot read {PIN_CONF}: {e}") from e
    write_mode(PIN_CONF, args.mode)
    print(f"MODE={args.mode} (was {old}); takes effect at the next boot")
    return 0


# ------------------------------------------------------------ boot log ---

BOOTS_LOG = "boots.log"
QUEUE_FILE = "queue.json"
PSTORE_DIR = Path("/sys/fs/pstore")
BOOT_ID_PATH = Path("/proc/sys/kernel/random/boot_id")
_LABEL_RE = re.compile(r"^g[0-9]+[a-z0-9-]*$")


def this_boot_id() -> str:
    """The running boot's id without dashes, the key of every record."""
    try:
        return BOOT_ID_PATH.read_text().strip().replace("-", "")
    except OSError as e:
        raise LabError(f"cannot read {BOOT_ID_PATH}: {e}") from e


def classify_prev_boot(prev_tail: str | None, cur_journal: str) -> str:
    """How the previous boot ended: none, clean, cold or warm.

    clean: its journal ends with 'Journal stopped'. Otherwise cold if this boot's
    clock started at 1970 (PMIC watchdog or power key, indistinguishable), else
    warm (expect a pstore record)."""
    if prev_tail is None:
        return "none"
    if prev_tail.rstrip().endswith("Journal stopped"):
        return "clean"
    if "erhai-rtc-sync: system clock is 1970" in cur_journal:
        return "cold"
    return "warm"


def parse_boots(text: str) -> list[dict[str, str]]:
    """boots.log text -> one dict of key=value pairs per line."""
    recs = []
    for line in text.splitlines():
        rec = dict(w.split("=", 1) for w in line.split() if "=" in w)
        if rec:
            recs.append(rec)
    return recs


def queue_matches(expect: str, cand: str) -> bool:
    """expect is a candidate name or 'package'; cand is 'package' or a candidate."""
    return expect == cand


def write_queue(state: Path, label: str, expect: str) -> None:
    if not _LABEL_RE.match(label):
        raise LabError(f"bad rung label {label!r}; expected e.g. g0")
    if label != "g0":
        raise LabError("only g0 runs at boot")
    if not expect or expect.split() != [expect]:
        raise LabError("--expect needs a candidate name or 'package'")
    state.mkdir(parents=True, exist_ok=True)
    tmp = state / (QUEUE_FILE + ".tmp")
    tmp.write_text(json.dumps({"label": label, "expect": expect}) + "\n")
    os.replace(tmp, state / QUEUE_FILE)


def read_queue(state: Path) -> dict | None:
    path = state / QUEUE_FILE
    try:
        text = path.read_text()
    except FileNotFoundError:
        return None
    except OSError as e:
        raise LabError(f"cannot read {path}: {e}") from e
    try:
        q = json.loads(text)
        if not isinstance(q["label"], str) or not isinstance(q["expect"], str):
            raise TypeError
    except (ValueError, KeyError, TypeError) as e:
        raise LabError(f"{path} is not a valid queue; remove it") from e
    return q


def _verdict(path: Path) -> str:
    lines = path.read_text(errors="replace").splitlines()
    return "FAIL" if any(line.startswith("FAIL ") for line in lines) else "PASS"


def prev_boot_id(boots_text: str, this_boot: str) -> str | None:
    """boot= of the last boots.log line, unless there is none or it is this boot."""
    recs = parse_boots(boots_text)
    last = recs[-1].get("boot") if recs else None
    return last if last and last != this_boot else None


def unlogged_boots(listing: list[dict], boots: list[dict], this_boot: str) -> list[str]:
    """Journal boots after the last boots.log boot that boot-run never logged.

    listing is `journalctl --list-boots -o json` ({"index", "boot_id", ...}). Only
    boots with a higher index than the last logged boot count: the journal also
    holds boots from before the lab was installed. This boot and logged ids are
    left out. No guess (empty) without a logged boot that the listing knows.
    Returns dashless ids in index order."""
    entries = [(e["index"], e["boot_id"].replace("-", "").lower()) for e in listing
               if isinstance(e, dict) and isinstance(e.get("index"), int)
               and isinstance(e.get("boot_id"), str)]
    last = boots[-1].get("boot") if boots else None
    after = [i for i, bid in entries if bid == last]
    if not after:
        return []
    logged = {rec.get("boot") for rec in boots}
    return [bid for i, bid in sorted(entries)
            if i > after[0] and bid != this_boot and bid not in logged]


def boot_run(state: Path, ident: dict, prev_tail: str | None, cur_journal: str,
             pstore_n: int, run_g0, preflight=None, unlogged: list[str] | None = None
             ) -> str:
    """Log this boot; run the queued g0 if the expected kernel booted.

    ident keys: boot_id, kver, cand ('package' or a candidate), build, stack, mode.
    unlogged: boots between the last logged boot and this one (unlogged_boots);
    if any, the previous boot is `prev=unknown` and they are named on the line.
    run_g0(out_path) appends the checker's output to out_path. preflight() runs
    before anything is written for a run and may raise LabError (missing helper).
    The queue is consumed before run_g0, so a rung runs at most once: a reset or
    error mid-run never repeats it on a later boot."""
    if unlogged:
        prev = "unknown"
        extra = f" unlogged={','.join(bid[:8] for bid in unlogged)}"
    else:
        prev = classify_prev_boot(prev_tail, cur_journal)
        extra = ""
    state.mkdir(parents=True, exist_ok=True)
    with open(state / BOOTS_LOG, "a") as f:
        f.write(f"boot={ident['boot_id']} kver={ident['kver']} cand={ident['cand']} "
                f"build={ident['build']} mode={ident['mode']} prev={prev} "
                f"pstore={pstore_n}{extra}\n")
    q = read_queue(state)
    if q is None:
        return "logged"
    if not queue_matches(q["expect"], ident["cand"]):
        return (f"queued {q['label']} expects {q['expect']}, "
                f"booted {ident['cand']}; kept")
    if q["label"] != "g0":
        raise LabError("only g0 runs at boot")
    if preflight is not None:
        preflight()
    out = state / f"{q['label']}-{ident['kver']}-{ident['boot_id'][:8]}.txt"
    out.write_text(f"# kver={ident['kver']} cand={ident['cand']} build={ident['build']} "
                   f"stack={ident['stack']} mode={ident['mode']} prev={prev}\n")
    (state / QUEUE_FILE).unlink()
    run_g0(out)
    verdict = _verdict(out)
    return f"ran {q['label']} -> {out} ({verdict})"


def _journal(*args: str) -> str | None:
    """journalctl stdout, or None if it fails or prints nothing."""
    try:
        r = subprocess.run(["journalctl", *args, "-o", "cat"], capture_output=True,
                           text=True, errors="replace")
    except OSError:
        return None
    return r.stdout if r.returncode == 0 and r.stdout.strip() else None


def _list_boots() -> list[dict]:
    """`journalctl --list-boots` as JSON, or [] if it fails or is not a JSON list."""
    try:
        r = subprocess.run(["journalctl", "--list-boots", "-o", "json", "--no-pager"],
                           capture_output=True, text=True, errors="replace")
    except OSError:
        return []
    if r.returncode != 0:
        return []
    try:
        listing = json.loads(r.stdout)
    except ValueError:
        return []
    return listing if isinstance(listing, list) else []


def _gather_ident() -> dict:
    cand, build, stack = lab_identity(PROC_CMDLINE.read_text())
    try:
        mode = read_mode(PIN_CONF.read_text())
    except (OSError, LabError):
        mode = "?"
    return {"boot_id": this_boot_id(),
            "kver": os.uname().release, "cand": cand or "package",
            "build": build or "-", "stack": stack or "-", "mode": mode}


def _run_g0(out: Path) -> None:
    """Append gpu-checks.sh g0 output to out; g0 exits 1 on any FAIL, which is fine."""
    checks = helper("gpu-checks.sh")
    with open(out, "a") as f:
        subprocess.run([str(checks), "g0"], stdout=f, stderr=subprocess.STDOUT)


def cmd_boot_run(args: argparse.Namespace) -> int:
    require_root("boot-run")
    try:
        try:
            pstore_n = len(list(PSTORE_DIR.iterdir()))
        except OSError:
            pstore_n = 0
        ident = _gather_ident()
        try:
            boots_text = (STATE_DIR / BOOTS_LOG).read_text()
        except OSError:
            boots_text = ""
        # a boot that froze before boot-run ran has no boots.log line: name it
        # instead of classifying the boot before it as the previous one
        unlogged = unlogged_boots(_list_boots(), parse_boots(boots_text),
                                  ident["boot_id"])
        prev_tail = None
        if not unlogged:
            # after a cold reset this boot's clock starts at 1970, so trust our own
            # log over `journalctl -b -1` to name the previous boot
            pid = prev_boot_id(boots_text, ident["boot_id"])
            prev_tail = (_journal("-b", pid, "-n", "20") if pid else None) \
                or _journal("-b", "-1", "-n", "20")
        msg = boot_run(STATE_DIR, ident, prev_tail, _journal("-b") or "", pstore_n,
                       _run_g0, preflight=lambda: helper("gpu-checks.sh"),
                       unlogged=unlogged)
    except Exception as e:  # noqa: BLE001 -- reported once, never retried
        print(f"erhai-lab: boot-run: {e}", file=sys.stderr)
        return 1
    print(msg)
    return 0


def cmd_queue(args: argparse.Namespace) -> int:
    require_root("queue")
    write_queue(STATE_DIR, args.label, args.expect)
    where = "the package kernel" if args.expect == "package" else f"lab kernel {args.expect}"
    print(f"queued {args.label}; it runs at the next boot of {where}")
    return 0


def status_report(state: Path, whoami: str, mode: str) -> str:
    out = [whoami, f"MODE={mode}"]
    try:
        q = read_queue(state)
    except LabError as e:
        out.append(f"queue: unreadable ({e})")
    else:
        out.append("queue: none" if q is None else f"queue: {q['label']} expects {q['expect']}")
    try:
        boots = (state / BOOTS_LOG).read_text().splitlines()
    except OSError:
        boots = []
    out.append("last boots:")
    out += [f"  {line}" for line in boots[-5:]] or ["  no boots logged"]
    files = []
    if state.is_dir():
        # not g1-*.txt: igt-recovery keeps its per-run logs (g1-<subtest>-*) here
        for pat in ("g0-*.txt", "g1-summary-*.txt", "power-*.txt"):
            files += [p for p in state.glob(pat) if p.is_file()]
    files = sorted(set(files), key=lambda p: (p.stat().st_mtime, p.name), reverse=True)[:5]
    out.append("evidence:")
    for p in files:
        lines = p.read_text(errors="replace").splitlines()
        npass = sum(1 for line in lines if line.startswith("PASS "))
        nfail = sum(1 for line in lines if line.startswith("FAIL "))
        out.append(f"  {p.name}  PASS={npass} FAIL={nfail}")
    if not files:
        out.append("  none")
    return "\n".join(out)


def cmd_status(args: argparse.Namespace) -> int:
    try:
        mode = read_mode(PIN_CONF.read_text())
    except (OSError, LabError):
        mode = "?"
    print(status_report(STATE_DIR, whoami_line(), mode))
    return 0


# -------------------------------------------------------------------- g1 ---

G1_PAUSE_S = 30
G1_WARNING = """\
g1 hangs the GPU on purpose (IGT msm_recovery), several times in a row.
A broken kernel can freeze the tablet hard. Before continuing:
  - keep an SSH session open from another machine (the screen may go dead)
  - a frozen tablet needs a long power-key hold to reset
  - evidence is kept in /var/lib/erhai-gpu/ (key: boot id, not the clock)"""


def g1_plan(runs: int, hangcheck: int) -> list[str]:
    return ["gpu-fault"] * runs + ["hangcheck"] * hangcheck


def g1_counts(args: argparse.Namespace) -> tuple[int, int]:
    """(runs, hangcheck): --pinned only changes the defaults, explicit values win."""
    runs, hangcheck = args.runs, args.hangcheck
    if runs is None:
        runs = 1 if args.pinned else 5
    if hangcheck is None:
        hangcheck = 0 if args.pinned else 1
    if runs < 0 or hangcheck < 0:
        raise LabError("--runs and --hangcheck must not be negative")
    if runs + hangcheck == 0:
        raise LabError("nothing to run (--runs and --hangcheck are both 0)")
    return runs, hangcheck


def run_g1(plan: list[str], control: str, allow_pinned: bool, run_one,
           pause) -> tuple[bool, list[str]]:
    """Run each subtest in order, stopping at the first non-zero exit.

    run_one(sub) -> (rc, last line); pause(seconds) separates runs (never trails)."""
    if control != "auto" and not allow_pinned:
        raise LabError("power/control is on; pass --pinned for the MODE=always run")
    lines: list[str] = []
    for n, sub in enumerate(plan):
        if n:
            pause(G1_PAUSE_S)
        rc, last = run_one(sub)
        lines.append(last)
        if rc != 0:
            return False, lines
    return True, lines


def last_nonempty(lines) -> str:
    last = ""
    for line in lines:
        if line.strip():
            last = line.strip()
    return last


def g1_header(kver: str, cand: str, control: str, plan: list[str]) -> str:
    return f"# kver={kver} cand={cand} control={control} plan={','.join(plan)}"


def g1_result_line(sub: str, rc: int, last: str) -> str:
    """The summary line for one run, never blank and never silently rc-less."""
    if not last:
        return f"FAIL g1 {sub} (no result line, rc={rc})"
    if rc != 0 and last.startswith("PASS"):
        return f"{last} (rc={rc})"
    return last


def g1_confirm(readline) -> None:
    print(G1_WARNING)
    print("Type 'yes' to continue: ", end="", flush=True)
    if readline().rstrip("\r\n") != "yes":
        raise LabError("aborted")


def run_one(sub: str) -> tuple[int, str]:
    """One igt-recovery run: stdout echoed live and captured, stderr passed through.

    Returns the exit code and the summary line (the wrapper's last non-empty line)."""
    seen = []
    with subprocess.Popen([str(helper("igt-recovery")), "run", sub],
                          stdout=subprocess.PIPE, text=True, errors="replace") as proc:
        for line in proc.stdout:
            print(line, end="", flush=True)
            seen.append(line)
        rc = proc.wait()
    line = g1_result_line(sub, rc, last_nonempty(seen))
    if rc == 0 and not line.startswith("PASS"):
        rc = 1      # a FAIL or missing line stops the ladder like a non-zero exit
    return rc, line


_G1_SUMMARY_RE = re.compile(r"^(g1-summary-.+-[0-9a-f]{8})(?:-([0-9]+))?\.txt$")


def g1_summary_path(state: Path, kver: str, boot8: str) -> Path:
    """g1-summary-<kver>-<boot8>.txt, or -2, -3, ... if earlier runs of this boot exist."""
    path = state / f"g1-summary-{kver}-{boot8}.txt"
    n = 1
    while path.exists():
        n += 1
        path = state / f"g1-summary-{kver}-{boot8}-{n}.txt"
    return path


def _g1_summary_order(path: Path) -> tuple[str, int]:
    """Sort key: by kver and boot, then run order (base, -2, ..., -10)."""
    m = _G1_SUMMARY_RE.match(path.name)
    return (m.group(1), int(m.group(2) or 1)) if m else (path.name, 0)


def _append_durable(f, text: str) -> None:
    """Write and force to disk: a frozen kernel must not lose finished runs."""
    f.write(text)
    f.flush()
    os.fsync(f.fileno())


def cmd_g1(args: argparse.Namespace) -> int:
    require_root("g1")
    runs, hangcheck = g1_counts(args)
    plan = g1_plan(runs, hangcheck)
    helper("igt-recovery")     # fail before the prompt if it is not installed
    boot_id = this_boot_id()
    try:
        control = GPU_CONTROL.read_text().strip()
        cand = lab_identity(PROC_CMDLINE.read_text())[0] or "package"
    except OSError as e:
        raise LabError(f"cannot read system state: {e}") from e
    kver = os.uname().release
    if control != "auto" and not args.pinned:
        raise LabError("power/control is on; pass --pinned for the MODE=always run")
    if not args.yes:
        g1_confirm(sys.stdin.readline)
    try:
        STATE_DIR.mkdir(parents=True, exist_ok=True)
    except OSError as e:
        raise LabError(f"cannot create {STATE_DIR}: {e}") from e
    out = g1_summary_path(STATE_DIR, kver, boot_id[:8])   # never overwrite a summary
    try:
        f = open(out, "x")
    except OSError as e:
        raise LabError(f"cannot write {out}: {e}") from e
    # Header first and each run's line as it finishes, fsynced: a summary with
    # no RESULT line means the kernel froze or the run was interrupted.
    with f:
        try:
            _append_durable(f, g1_header(kver, cand, control, plan) + "\n")

            def recorded(sub: str) -> tuple[int, str]:
                rc, line = run_one(sub)
                _append_durable(f, line + "\n")
                return rc, line

            passed, lines = run_g1(plan, control, args.pinned, recorded, time.sleep)
            _append_durable(f, "RESULT PASS\n" if passed else "RESULT FAIL\n")
        except OSError as e:
            raise LabError(f"cannot write {out}: {e}") from e
    print(f"g1: {'PASS' if passed else 'FAIL'} ({len(lines)}/{len(plan)} runs); summary: {out}")
    return 0 if passed else 1


# ----------------------------------------------------------------- power ---

BASELINE_MW = 3639      # package kernel, MODE=once, 2026-10-28
POWER_INTERVAL_S = 10


def _charger_error(epoch: int) -> LabError:
    return LabError(f"charger connected (current_now >= 0 at {epoch}); unplug and rerun")


def power_verdict(avg: float) -> tuple[str, bool]:
    """(avg shown with one decimal, shown value <= baseline): text and verdict agree."""
    shown = f"{avg:.1f}"
    return shown, float(shown) <= BASELINE_MW


def avg_discharge_mw(samples: list[tuple[int, int, int]]) -> float:
    """Mean battery power in mW of (epoch, voltage uV, current uA) samples.

    Current is negative while discharging; a sample at >= 0 means a charger
    (or no load) and the measurement is meaningless."""
    if not samples:
        raise LabError("no power samples")
    for epoch, _, current in samples:
        if current >= 0:
            raise _charger_error(epoch)
    return sum(v * -i / 1e9 for _, v, i in samples) / len(samples)


def format_samples(samples: list[tuple[int, int, int]]) -> str:
    """`<epoch> <uV> <uA>` lines, the format of the idle-baseline evidence."""
    return "".join(f"{e} {v} {i}\n" for e, v, i in samples)


def sample_battery(count: int, battery: Path = BATTERY, sleep=time.sleep,
                   clock=lambda: int(time.time())) -> list[tuple[int, int, int]]:
    """Read voltage_now/current_now `count` times, POWER_INTERVAL_S apart.

    A charger on the first sample refuses at once instead of after the whole
    window. The epoch is only a label for the refusal message; nothing keys on it."""
    samples = []
    for n in range(count):
        if n:
            sleep(POWER_INTERVAL_S)
        try:
            v = int((battery / "voltage_now").read_text())
            i = int((battery / "current_now").read_text())
        except (OSError, ValueError) as e:
            raise LabError(f"cannot read {battery}: {e}") from e
        samples.append((clock(), v, i))
        if n == 0 and i >= 0:
            raise _charger_error(samples[0][0])
    return samples


def cmd_power(args: argparse.Namespace) -> int:
    require_root("power")
    if args.minutes < 0:
        raise LabError("--minutes must not be negative")
    kver = os.uname().release
    boot_id = this_boot_id()
    count = args.minutes * 60 // POWER_INTERVAL_S
    print("Method: unplug the charger, screen on at a fixed brightness, Wi-Fi on, "
          "no apps running.")
    print(f"Sampling every {POWER_INTERVAL_S} s for {args.minutes} min ({count} samples)...",
          flush=True)
    samples = sample_battery(count)
    out = STATE_DIR / f"power-{kver}-{boot_id[:8]}.txt"
    try:     # kept even when averaging refuses (a charger plugged in mid-window)
        STATE_DIR.mkdir(parents=True, exist_ok=True)
        out.write_text(format_samples(samples))
    except OSError as e:
        raise LabError(f"cannot write {out}: {e}") from e
    shown, ok = power_verdict(avg_discharge_mw(samples))
    print(f"avg={shown} mW over {len(samples)} samples; baseline {BASELINE_MW} mW; "
          f"candidate <= baseline: {'yes' if ok else 'no'}")
    print(f"samples: {out}")
    return 0


# ------------------------------------------------------------------ soak ---

SOAK_FILE = "soak.json"
SOAK_CYCLES_LOG = "soak-cycles.log"
SOAK_TIMER = "erhai-gpu-lab-soak.timer"
SOAK_WINDOW_S = 3000
SOAK_TARGET_CYCLES = 1000
WEDGE_RE = re.compile(r"GMU OOB|HFI .*timed out|hangcheck recover!|a8xx_recover|"
                      r"cx gdsc didn't collapse")
_CYCLES_LINE_RE = re.compile(r"\bcycles=(\d+)")


def soak_boot_ids(boots: list[dict], start_line: int, start_boot: str | None = None,
                  stop_line: int | None = None) -> list[str]:
    """Boot ids of a soak: the start boot plus the boots.log lines in
    [start_line, stop_line) (to the end while the soak runs).

    `soak start` runs after boot-run logged its own boot, so without start_boot the
    start boot is the last line before start_line. Ids are deduplicated."""
    ids = []
    if start_boot is None and 0 < start_line <= len(boots):
        start_boot = boots[start_line - 1].get("boot")
    if start_boot:
        ids.append(start_boot)
    for rec in boots[start_line:stop_line]:
        bid = rec.get("boot")
        if bid and bid not in ids:
            ids.append(bid)
    return ids


def soak_summary(cycles_log: str, boots: list[dict], start_line: int,
                 kernel_logs: dict[str, str], start_boot: str | None = None,
                 stop_line: int | None = None) -> dict:
    """Totals of a soak from its window log, boots.log and per-boot kernel logs.

    Only boot ids and line order are used, never timestamps (a cold reset restarts
    the clock at 1970). A reset is a boot after the start whose `prev` is warm or
    cold, plus each boot named in `unlogged=` (it froze before boot-run logged
    it; kind "unlogged", id8 only, counted in boots); the start boot's own
    predecessors ended before the soak."""
    secs = cycles = 0
    for line in cycles_log.splitlines():
        rec = dict(w.split("=", 1) for w in line.split() if "=" in w)
        try:
            s, c = int(rec["secs"]), int(rec["cycles"])
        except (KeyError, ValueError):
            continue
        secs += s
        cycles += c
    ids = soak_boot_ids(boots, start_line, start_boot, stop_line)
    resets: list[tuple[str, str]] = []
    unlogged = 0
    for rec in boots[start_line:stop_line]:
        if rec.get("boot") not in ids or rec.get("boot") == ids[0]:
            continue
        if rec.get("prev") in ("warm", "cold"):
            resets.append((rec["boot"], rec["prev"]))
        elif rec.get("prev") == "unknown" and rec.get("unlogged"):
            lost = [bid for bid in rec["unlogged"].split(",") if bid]
            resets += [(bid, "unlogged") for bid in lost]
            unlogged += len(lost)
    wedges = [(bid, line) for bid in ids
              for line in kernel_logs.get(bid, "").splitlines() if WEDGE_RE.search(line)]
    return {"hours": secs / 3600, "cycles": cycles, "boots": len(ids) + unlogged,
            "resets": resets, "wedge_lines": wedges,
            "cycles_ok": cycles >= SOAK_TARGET_CYCLES}


def _read_soak(state: Path) -> dict | None:
    try:
        return json.loads((state / SOAK_FILE).read_text())
    except FileNotFoundError:
        return None
    except (OSError, ValueError) as e:
        raise LabError(f"cannot read {state / SOAK_FILE}: {e}") from e


def _write_json(path: Path, obj: dict) -> None:
    """Replace path with obj as JSON atomically (a tmp file beside it)."""
    tmp = path.with_name(f".{path.name}.tmp")
    tmp.write_text(json.dumps(obj) + "\n")
    os.replace(tmp, path)


def _soak_window(soak: dict) -> tuple[int, str | None, int | None]:
    """(start_line, start_boot, stop_line) of soak.json; stop_line None while running."""
    return soak.get("start_line", 0), soak.get("start_boot"), soak.get("stop_line")


def _boots_records(state: Path) -> list[dict[str, str]]:
    try:
        return parse_boots((state / BOOTS_LOG).read_text())
    except OSError:
        return []


def _systemctl(*args: str) -> None:
    if subprocess.run(["systemctl", *args]).returncode != 0:
        raise LabError(f"systemctl {' '.join(args)} failed")


def soak_start() -> int:
    require_root("soak start")
    state_file = STATE_DIR / SOAK_FILE
    old = _read_soak(STATE_DIR)
    if old is not None and _soak_window(old)[2] is None:
        raise LabError("soak already running; soak stop first")
    start = {"start_boot": this_boot_id(),
             "start_line": len(_boots_records(STATE_DIR))}
    try:
        STATE_DIR.mkdir(parents=True, exist_ok=True)
        _write_json(state_file, start)
    except OSError as e:
        raise LabError(f"cannot write soak state in {STATE_DIR}: {e}") from e
    try:
        # state first: enabling --now fires the overdue OnBootSec timer at once
        _systemctl("enable", "--now", SOAK_TIMER)
    except LabError:
        if old is None:
            state_file.unlink(missing_ok=True)
        else:
            _write_json(state_file, old)    # the stopped soak stays as it was
        raise
    # the first window takes SOAK_WINDOW_S to finish, so nothing is appended yet
    try:
        (STATE_DIR / SOAK_CYCLES_LOG).write_text("")
    except OSError as e:
        raise LabError(f"cannot empty {STATE_DIR / SOAK_CYCLES_LOG}: {e}; "
                       "the soak timer is already enabled") from e
    print(f"soak started on boot {start['start_boot'][:8]}; one {SOAK_WINDOW_S} s "
          f"window about every hour, goal {SOAK_TARGET_CYCLES} cycles "
          "(erhai-gpu-lab soak status)")
    return 0


def soak_stop() -> int:
    """Close the soak window at the current end of boots.log, then disable the timer.

    The window closes first, so a failed disable still leaves tick a no-op.
    A second stop keeps the first stop_line."""
    require_root("soak stop")
    try:
        soak = _read_soak(STATE_DIR)
    except LabError as e:
        print(f"erhai-lab: soak stop: {e}; window not closed", file=sys.stderr)
        soak = None
    if soak is not None and _soak_window(soak)[2] is None:
        soak["stop_line"] = len(_boots_records(STATE_DIR))
        try:
            _write_json(STATE_DIR / SOAK_FILE, soak)
        except OSError as e:
            raise LabError(f"cannot write {STATE_DIR / SOAK_FILE}: {e}") from e
    _systemctl("disable", "--now", SOAK_TIMER)
    print(f"soak stopped and timer disabled; results kept in {STATE_DIR}")
    return 0


def soak_tick() -> int:
    """One cycle-counting window, run by erhai-gpu-lab-soak.service."""
    soak = _read_soak(STATE_DIR)
    if soak is None or _soak_window(soak)[2] is not None:
        return 0
    require_root("soak tick")
    res = subprocess.run([str(helper("gpu-checks.sh")), "cycles", str(SOAK_WINDOW_S)],
                         capture_output=True, text=True, errors="replace")
    m = _CYCLES_LINE_RE.search(res.stdout)
    if res.returncode != 0 or not m:
        detail = (res.stderr or res.stdout).strip() or f"exit {res.returncode}"
        why = "window failed" if res.returncode != 0 else "no cycles= line in output"
        print(f"erhai-lab: soak tick: {why}, not recorded: {detail}", file=sys.stderr)
        return 1
    with open(STATE_DIR / SOAK_CYCLES_LOG, "a") as f:
        f.write(f"boot={this_boot_id()} secs={SOAK_WINDOW_S} cycles={m.group(1)}\n")
    return 0


def soak_status() -> int:
    soak = _read_soak(STATE_DIR)
    if soak is None:
        print("no soak in progress (erhai-gpu-lab soak start)")
        return 0
    boots = _boots_records(STATE_DIR)
    start_line, start_boot, stop_line = _soak_window(soak)
    kernel_logs = {bid: _journal("-k", "-b", bid) or ""
                   for bid in soak_boot_ids(boots, start_line, start_boot, stop_line)}
    try:
        cycles_log = (STATE_DIR / SOAK_CYCLES_LOG).read_text()
    except OSError:
        cycles_log = ""
    s = soak_summary(cycles_log, boots, start_line, kernel_logs, start_boot, stop_line)
    print("soak: running" if stop_line is None else "soak: stopped")
    print(f"hours: {s['hours']:.2f}")
    print(f"cycles: {s['cycles']} (>= {SOAK_TARGET_CYCLES}: "
          f"{'yes' if s['cycles_ok'] else 'no'})")
    print(f"boots: {s['boots']}")
    for bid, kind in s["resets"]:
        print(f"reset {bid[:8]} {kind}")
    for bid, line in s["wedge_lines"]:
        print(f"wedge {bid[:8]} {line}")
    return 0


def cmd_soak(args: argparse.Namespace) -> int:
    return {"start": soak_start, "stop": soak_stop, "tick": soak_tick,
            "status": soak_status}[args.soak_cmd]()


# ---------------------------------------------------------------- report ---

NO_WEDGE_LOGS = "wedge lines not collected (run as root: erhai-gpu-lab report)"


def _read_text(path: Path) -> str:
    try:
        return path.read_text(errors="replace")
    except OSError as e:
        return f"unreadable: {e}"


def _report_boots(boots: list[dict[str, str]]) -> list[str]:
    out = ["## Boots", "", "| boot | kver | cand | mode | prev |", "|---|---|---|---|---|"]
    for rec in boots:
        out.append("| " + " | ".join([rec.get("boot", "-")[:8]]
                                     + [rec.get(k, "-") for k in ("kver", "cand", "mode", "prev")])
                   + " |")
    return out


def _report_g0(path: Path) -> list[str]:
    lines = _read_text(path).splitlines()
    count = {k: sum(1 for ln in lines if ln.startswith(k + " ")) for k in ("PASS", "FAIL", "INFO")}
    out = [f"### {path.name}", ""]
    if lines and lines[0].startswith("#"):
        out += [f"`{lines[0]}`", ""]
    out.append(f"PASS {count['PASS']} / FAIL {count['FAIL']} / INFO {count['INFO']}")
    fails = [ln for ln in lines if ln.startswith("FAIL ")]
    if fails:
        out += ["", "```", *fails, "```"]
    return out


def _report_g1(path: Path) -> list[str]:
    lines = _read_text(path).splitlines()
    if not any(ln.startswith("RESULT ") for ln in lines):
        lines.append("RESULT missing (froze or interrupted)")
    return [f"### {path.name}", "", "```", *lines, "```"]


def _report_soak(state: Path, boots: list[dict[str, str]],
                 kernel_logs: dict[str, str] | None) -> list[str]:
    try:
        soak = _read_soak(state)
    except LabError as e:
        return ["## Soak", "", str(e)]
    if soak is None:
        return []
    cycles_log = _read_text(state / SOAK_CYCLES_LOG)
    if cycles_log.startswith("unreadable: "):
        cycles_log = ""
    start_line, start_boot, stop_line = _soak_window(soak)
    s = soak_summary(cycles_log, boots, start_line, kernel_logs or {}, start_boot, stop_line)
    out = ["## Soak", "", "```", f"hours: {s['hours']:.2f}",
           f"cycles: {s['cycles']} (>= {SOAK_TARGET_CYCLES}: {'yes' if s['cycles_ok'] else 'no'})",
           f"boots: {s['boots']}"]
    out += [f"reset {bid[:8]} {kind}" for bid, kind in s["resets"]]
    out += [f"wedge {bid[:8]} {line}" for bid, line in s["wedge_lines"]]
    out.append("```")
    if kernel_logs is None:
        out += ["", NO_WEDGE_LOGS]
    return out


def _report_power(path: Path) -> str:
    samples = []
    for line in _read_text(path).splitlines():
        try:
            e, v, i = (int(w) for w in line.split())
        except ValueError:
            continue
        samples.append((e, v, i))
    try:
        shown, ok = power_verdict(avg_discharge_mw(samples))
    except LabError as e:
        return f"- {path.name}: {e}"
    return (f"- {path.name}: avg {shown} mW over {len(samples)} samples; "
            f"baseline {BASELINE_MW} mW; candidate <= baseline: {'yes' if ok else 'no'}")


def render_report(state: Path, kernel_logs: dict[str, str] | None = None) -> str:
    """All evidence in `state` as Markdown for docs/ladder.md Results.

    kernel_logs maps a dashless boot id to its kernel log for the soak's wedge
    lines; None means they were not collected (not root). Missing files are
    skipped; with no evidence at all the result is 'No evidence in <state>.'"""
    def files(pattern: str) -> list[Path]:
        return sorted(p for p in state.glob(pattern) if p.is_file()) if state.is_dir() else []

    boots = _boots_records(state)
    g0, g1, power = files("g0-*.txt"), files("g1-summary-*.txt"), files("power-*.txt")
    g1.sort(key=_g1_summary_order)
    soak = _report_soak(state, boots, kernel_logs)
    sections = []
    if boots:
        sections.append(_report_boots(boots))
    if g0:
        sections.append(["## g0"] + [ln for p in g0 for ln in ["", *_report_g0(p)]])
    if g1:
        sections.append(["## g1"] + [ln for p in g1 for ln in ["", *_report_g1(p)]])
    if soak:
        sections.append(soak)
    if power:
        sections.append(["## Power", ""] + [_report_power(p) for p in power])
    if not sections:
        return f"No evidence in {state}."
    return "\n\n".join("\n".join(s) for s in sections) + "\n"


def cmd_report(args: argparse.Namespace) -> int:
    kernel_logs = None
    if os.geteuid() == 0:
        try:
            soak = _read_soak(STATE_DIR)
        except LabError:
            soak = None     # render_report shows the unreadable soak.json itself
        ids = soak_boot_ids(_boots_records(STATE_DIR), *_soak_window(soak)) if soak else []
        kernel_logs = {bid: _journal("-k", "-b", bid) or "" for bid in ids}
    text = render_report(STATE_DIR, kernel_logs)
    if args.out:
        try:
            Path(args.out).write_text(text if text.endswith("\n") else text + "\n")
        except OSError as e:
            raise LabError(f"cannot write {args.out}: {e}") from e
    else:
        print(text, end="" if text.endswith("\n") else "\n")
    return 0


# ------------------------------------------------------------------- cli ---

def require_root(what: str) -> None:
    if os.geteuid() != 0:
        raise LabError(f"{what} needs root; run it with sudo")


def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(prog="erhai-lab", description=__doc__,
                                formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = p.add_subparsers(dest="cmd", required=True)

    f = sub.add_parser("fetch", help="download, verify and install a lab kernel")
    f.add_argument("candidate")
    f.add_argument("--tag", help="exact release tag (default: latest for the candidate)")
    f.add_argument("--repo", default=REPO)
    f.add_argument("--from-dir", metavar="DIR",
                   help="install a local build (tools/build-local.sh's out/<candidate>/) instead of a release")
    f.add_argument("--verify-only", action="store_true",
                   help="download and verify, install nothing")
    f.set_defaults(func=cmd_fetch)

    sub.add_parser("whoami", help="which lab candidate is booted").set_defaults(func=cmd_whoami)
    sub.add_parser("setup", help="install g1 tools and build IGT (root)"
                   ).set_defaults(func=cmd_setup)
    m = sub.add_parser("mode", help="set the GPU pin policy and its services (root)")
    m.add_argument("mode", choices=MODES)
    m.set_defaults(func=cmd_mode)
    q = sub.add_parser("queue", help="queue a g0 check for the next boot (root)")
    q.add_argument("label")
    q.add_argument("--expect", required=True, metavar="CAND|package",
                   help="kernel that must be booted for the rung to run")
    q.set_defaults(func=cmd_queue)
    sub.add_parser("boot-run", help="log this boot, run the queued g0 (root, boot service)"
                   ).set_defaults(func=cmd_boot_run)
    sub.add_parser("status", help="mode, queue, recent boots and evidence"
                   ).set_defaults(func=cmd_status)
    g = sub.add_parser("g1", help="IGT msm_recovery ladder, stops at the first FAIL (root)")
    g.add_argument("--runs", type=int, default=None,
                   help="gpu-fault runs (default: 5; 1 with --pinned)")
    g.add_argument("--hangcheck", type=int, default=None,
                   help="hangcheck runs after those (default: 1; 0 with --pinned)")
    g.add_argument("--pinned", action="store_true",
                   help="allow power/control=on (the MODE=always run)")
    g.add_argument("--yes", action="store_true", help="skip the confirmation prompt")
    g.set_defaults(func=cmd_g1)
    w = sub.add_parser("power", help="idle power vs the 3639 mW baseline (root)")
    w.add_argument("--minutes", type=int, default=30,
                   help="sampling duration (default: 30; one sample every 10 s)")
    w.set_defaults(func=cmd_power)
    k = sub.add_parser("soak", help="g2 runtime-PM cycle soak across reboots")
    ksub = k.add_subparsers(dest="soak_cmd", required=True)
    ksub.add_parser("start", help="begin a soak and enable its timer (root)")
    ksub.add_parser("stop", help="disable the soak timer, keep the results (root)")
    ksub.add_parser("tick", help="run one cycle window (root, soak service)")
    ksub.add_parser("status", help="hours, cycles, boots, resets and wedge lines")
    k.set_defaults(func=cmd_soak)
    r = sub.add_parser("report", help="all evidence as Markdown for the ladder Results")
    r.add_argument("--out", metavar="FILE", help="write FILE instead of printing")
    r.set_defaults(func=cmd_report)
    return p


def main(argv: list[str] | None = None) -> int:
    args = build_parser().parse_args(argv)
    try:
        return args.func(args)
    except LabError as e:
        print(f"erhai-lab: {e}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    sys.exit(main())
