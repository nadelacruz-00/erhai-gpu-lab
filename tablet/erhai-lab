class LabError(Exception):
    """A refusal or failure with a reason the user should see verbatim."""


def lab_identity(cmdline: str) -> tuple[str, str, str]:
    """(candidate, build, stack) from erhai_lab.* params on a lab UKI's cmdline."""
    cand = build = stack = ""
    for word in cmdline.split():
        if word.startswith("erhai_lab.candidate="):
            cand = word.split("=", 1)[1]
        elif word.startswith("erhai_lab.build="):
            build = word.split("=", 1)[1]
        elif word.startswith("erhai_lab.stack="):
            stack = word.split("=", 1)[1]
    return cand, build, stack


# ----------------------------------------------------------------- fetch ---

def parse_sums(text: str) -> dict[str, str]:
    """sha256sum output -> {filename: hexdigest}."""
    sums: dict[str, str] = {}
    for n, line in enumerate(text.splitlines(), 1):
        if not line.strip():
            continue
        m = re.fullmatch(r"([0-9a-f]{64}) [ *](.+)", line.strip())
        if not m:
            raise LabError(f"SHA256SUMS line {n} is malformed: {line!r}")
        sums[m.group(2)] = m.group(1)
    if not sums:
        raise LabError("SHA256SUMS is empty")
    return sums


def sha256_file(path: Path) -> str:
    h = hashlib.sha256()
    with path.open("rb") as f:
        for chunk in iter(lambda: f.read(1 << 20), b""):
            h.update(chunk)
    return h.hexdigest()


def verify_assets(directory: Path) -> None:
    """Every downloaded file must be listed in SHA256SUMS and match it."""
    sums_path = directory / "SHA256SUMS"
    if not sums_path.is_file():
        raise LabError("release has no SHA256SUMS; refusing to install")
    sums = parse_sums(sums_path.read_text())
    present = {p.name for p in directory.iterdir() if p.is_file()} - {"SHA256SUMS"}
    missing = sorted(set(sums) - present)
    if missing:
        raise LabError(f"listed in SHA256SUMS but not downloaded: {missing}")
    unlisted = sorted(present - set(sums))
    if unlisted:
        raise LabError(f"downloaded but not listed in SHA256SUMS: {unlisted}")
    for name, want in sorted(sums.items()):
        got = sha256_file(directory / name)
        if got != want:
            raise LabError(f"checksum mismatch for {name}: {got} != {want}")


@dataclasses.dataclass
class Assets:
    kver: str
    uki: Path
    modules: Path
    config: Path


def identify_assets(directory: Path, candidate: str) -> Assets:
    """One UKI, one modules tarball, one config, all for the same lab kver."""
    names = sorted(p.name for p in directory.iterdir() if p.is_file())
    ukis = [n for n in names if n.endswith(".efi")]
    mods = [n for n in names if n.startswith("modules-") and n.endswith(".tar.zst")]
    cfgs = [n for n in names if n.startswith("config-")]
    if len(ukis) != 1 or len(mods) != 1 or len(cfgs) != 1:
        raise LabError(f"expected one .efi, one modules tarball and one config, got {names}")
    kver = ukis[0][: -len(".efi")]
    if mods[0] != f"modules-{kver}.tar.zst" or cfgs[0] != f"config-{kver}":
        raise LabError(f"UKI {ukis[0]} does not match {mods[0]} / {cfgs[0]}")
    if not kver.endswith(f"-lab-{candidate}"):
        raise LabError(f"kernelrelease {kver} is not a lab build of {candidate}")
    return Assets(kver, directory / ukis[0], directory / mods[0], directory / cfgs[0])


def latest_tag(tags: list[str], candidate: str) -> str:
    """Highest lab-<candidate>-<run> tag."""
    prefix = f"lab-{candidate}-"
    runs = []
    for t in tags:
        if t.startswith(prefix) and t[len(prefix):].isdigit():
            runs.append(int(t[len(prefix):]))
    if not runs:
        raise LabError(f"no release found for candidate {candidate}")
    return f"{prefix}{max(runs)}"


API = "https://api.github.com"


def http_get(url: str, accept: str = "application/vnd.github+json") -> bytes:
    """Anonymous HTTPS GET: the lab repo is public, and fetch runs as root,
    which has no gh login."""
    import urllib.error
    import urllib.request
    req = urllib.request.Request(url, headers={"Accept": accept,
                                               "User-Agent": "erhai-lab"})
    try:
        with urllib.request.urlopen(req, timeout=60) as r:
            return r.read()
    except urllib.error.HTTPError as e:
        raise LabError(f"GET {url}: HTTP {e.code} {e.reason}") from None
    except urllib.error.URLError as e:
        raise LabError(f"GET {url}: {e.reason}") from None


def release_assets(releases: list[dict], tag: str) -> list[tuple[str, str]]:
    """(name, download url) of every asset of the release tagged `tag`."""
    for r in releases:
        if r.get("tag_name") == tag:
            return [(a["name"], a["browser_download_url"]) for a in r.get("assets", [])]
    raise LabError(f"release {tag} not found")


def install_assets(assets: Assets, boot_dir: Path = BOOT_DIR,
                   modules_dir: Path = MODULES_DIR) -> None:
    """Copy a verified lab kernel beside the package kernel.

    Only ever writes /boot/<lab kver>.efi and /usr/lib/modules/<lab kver>/;
    the package's UKI, its modules and rEFInd's default are never touched.
    """
    if "-lab-" not in assets.kver:
        raise LabError(f"refusing to install non-lab kernelrelease {assets.kver}")
    target = modules_dir / assets.kver
    staging = Path(tempfile.mkdtemp(prefix=".erhai-lab-", dir=modules_dir))
    try:
        subprocess.run(["tar", "--zstd", "-x", "-f", str(assets.modules),
                        "-C", str(staging)], check=True)
        unpacked = staging / assets.kver
        if not unpacked.is_dir():
            raise LabError(f"modules tarball has no {assets.kver}/ directory")
        if target.exists():
            shutil.rmtree(target)
        unpacked.rename(target)
    finally:
        shutil.rmtree(staging, ignore_errors=True)
    tmp_uki = boot_dir / f".{assets.kver}.efi.tmp"
    shutil.copyfile(assets.uki, tmp_uki)
    os.replace(tmp_uki, boot_dir / f"{assets.kver}.efi")
    subprocess.run(["depmod", "-a", assets.kver], check=True)


def find_release(repo: str, candidate: str, tag: str | None,
                 get=http_get) -> tuple[str, list[tuple[str, str]]]:
    """(tag, assets) of the requested or latest release of `candidate`.

    The anonymous release list can come back empty while the releases exist
    (seen 2026-10-23: the list returned [] and /releases/tags/<tag> answered),
    so an explicit tag missing from the list is looked up by tag.
    """
    releases = json.loads(get(f"{API}/repos/{repo}/releases?per_page=100"))
    if not tag:
        if not releases:
            raise LabError("GitHub returned an empty release list; pass "
                           f"--tag lab-{candidate}-<run> (see the repo's Releases page)")
        tag = latest_tag([r["tag_name"] for r in releases], candidate)
    if not any(r.get("tag_name") == tag for r in releases):
        releases = [json.loads(get(f"{API}/repos/{repo}/releases/tags/{tag}"))]
    return tag, release_assets(releases, tag)


def cmd_fetch(args: argparse.Namespace) -> int:
    tag, assets_list = find_release(args.repo, args.candidate, args.tag)
    with tempfile.TemporaryDirectory(prefix="erhai-lab-fetch-") as tmp:
        d = Path(tmp)
        for name, url in assets_list:
            if "/" in name or name.startswith("."):
                raise LabError(f"refusing asset name {name!r}")
            print(f"  downloading {name}")
            (d / name).write_bytes(http_get(url, "application/octet-stream"))
        verify_assets(d)
        assets = identify_assets(d, args.candidate)
        print(f"{tag}: verified {assets.kver} ({len(parse_sums((d / 'SHA256SUMS').read_text()))} files)")
        if args.verify_only:
            return 0
        require_root("fetch")
        install_assets(assets)
    print(f"installed /boot/{assets.kver}.efi and {MODULES_DIR / assets.kver}/")
    print("Pick it in the rEFInd menu on the next boot; the default entry is unchanged.")
    return 0


def whoami_line() -> str:
    cand, build, stack = lab_identity(PROC_CMDLINE.read_text())
    kver = os.uname().release
    if cand:
        return (f"{kver}: lab candidate {cand}, build {build or '?'}"
                + (f", stack={stack}" if stack else ""))
    return f"{kver}: package kernel (not a lab build)"


def cmd_whoami(args: argparse.Namespace) -> int:
    print(whoami_line())
    return 0


# ----------------------------------------------------------------- setup ---

def helper(name: str) -> Path:
    """Path of an installed helper under LIB_DIR."""
    path = LIB_DIR / name
    if not path.is_file():
        raise LabError(f"{name} not installed; run sudo tablet/install.sh")
    return path


def cmd_setup(args: argparse.Namespace) -> int:
    require_root("setup")
    steps = [("setup.sh", [str(helper("setup.sh"))], None),
             ("igt-recovery build", [str(helper("igt-recovery")), "build"],
              {"IGT_DIR": str(STATE_DIR / "igt")})]
    for step, cmd, extra_env in steps:
        env = {**os.environ, **extra_env} if extra_env else None
        if subprocess.run(cmd, env=env).returncode != 0:
            raise LabError(f"setup step failed: {step}")
    return 0


# ------------------------------------------------------------------ mode ---

MODES = ("once", "always")
_MODE_RE = re.compile(r"^[ \t]*MODE=([^\r\n]*)", re.MULTILINE)
PIN_SERVICE = {"once": "erhai-gpu-pin-once.service", "always": "erhai-gpu-pin.service"}


def read_mode(text: str) -> str:
    """Value of the last uncommented MODE= line."""
    found = _MODE_RE.findall(text)
    if not found:
        raise LabError("no MODE= line in the pin config")
    return found[-1].strip()


def set_mode_text(text: str, mode: str) -> str:
    """text with only the last uncommented MODE= line changed."""
    if mode not in MODES:
        raise LabError(f"unknown mode {mode!r}; use once or always")
    last = None
    for last in _MODE_RE.finditer(text):
        pass
    if last is None:
        raise LabError("no MODE= line in the pin config; refusing to guess")
    return text[:last.start(1)] + mode + text[last.end(1):]


def write_mode(conf: Path, mode: str, run=subprocess.run) -> None:
    """Rewrite MODE= in conf atomically, then align the two pin services.

    MODE=once  <=> erhai-gpu-pin-once.service enabled, erhai-gpu-pin.service disabled;
    MODE=always is the reverse. Nothing is started or stopped: boot-time only."""
    if mode not in MODES:
        raise LabError(f"unknown mode {mode!r}; use once or always")
    tmp = None
    try:
        with open(conf, newline="") as f:  # keep CRLF/no-final-newline as is
            text = f.read()
        new = set_mode_text(text, mode)
        st = conf.stat()
        fd, tmp = tempfile.mkstemp(dir=conf.parent, prefix=f".{conf.name}.")
        with os.fdopen(fd, "w", newline="") as f:
            f.write(new)
            f.flush()
            os.fsync(f.fileno())
        os.chmod(tmp, st.st_mode & 0o7777)
        if os.geteuid() == 0:
            os.chown(tmp, st.st_uid, st.st_gid)
        os.replace(tmp, conf)
        tmp = None
    except OSError as e:
        raise LabError(f"could not rewrite {conf}: {e}") from e
    finally:
        if tmp is not None:
            try:
                os.unlink(tmp)
            except OSError:
                pass
    other = "once" if mode == "always" else "always"
    for action, svc in (("enable", PIN_SERVICE[mode]), ("disable", PIN_SERVICE[other])):
        cmd = ["systemctl", action, svc]
        try:
            rc = run(cmd).returncode
        except OSError as e:
            raise LabError(f"{' '.join(cmd)} could not run: {e}; "
                           f"{conf} is already rewritten to MODE={mode}") from e
        if rc != 0:
            raise LabError(f"{' '.join(cmd)} failed (exit {rc}); "
                           f"{conf} is already rewritten to MODE={mode}")


def cmd_mode(args: argparse.Namespace) -> int:
    require_root("mode")
    try:
        old = read_mode(PIN_CONF.read_text())
    except OSError as e:
        raise LabError(f"cannot read {PIN_CONF}: {e}") from e
    write_mode(PIN_CONF, args.mode)
    print(f"MODE={args.mode} (was {old}); takes effect at the next boot")
    return 0


# ------------------------------------------------------------ boot log ---

BOOTS_LOG = "boots.log"
QUEUE_FILE = "queue.json"
PSTORE_DIR = Path("/sys/fs/pstore")
BOOT_ID_PATH = Path("/proc/sys/kernel/random/boot_id")
_LABEL_RE = re.compile(r"^g[0-9]+[a-z0-9-]*$")


def classify_prev_boot(prev_tail: str | None, cur_journal: str) -> str:
    """How the previous boot ended: none, clean, cold or warm.

    clean: its journal ends with 'Journal stopped'. Otherwise cold if this boot's
    clock started at 1970 (PMIC watchdog or power key, indistinguishable), else
    warm (expect a pstore record)."""
    if prev_tail is None:
        return "none"
    if prev_tail.rstrip().endswith("Journal stopped"):
        return "clean"
    if "erhai-rtc-sync: system clock is 1970" in cur_journal:
        return "cold"
    return "warm"


def parse_boots(text: str) -> list[dict[str, str]]:
    """boots.log text -> one dict of key=value pairs per line."""
    recs = []
    for line in text.splitlines():
        rec = dict(w.split("=", 1) for w in line.split() if "=" in w)
        if rec:
            recs.append(rec)
    return recs


def queue_matches(expect: str, cand: str) -> bool:
    """expect is a candidate name or 'package'; cand is 'package' or a candidate."""
    return expect == cand


def write_queue(state: Path, label: str, expect: str) -> None:
    if not _LABEL_RE.match(label):
        raise LabError(f"bad rung label {label!r}; expected e.g. g0")
    if label != "g0":
        raise LabError("only g0 runs at boot")
    if not expect or expect.split() != [expect]:
        raise LabError("--expect needs a candidate name or 'package'")
    state.mkdir(parents=True, exist_ok=True)
    tmp = state / (QUEUE_FILE + ".tmp")
    tmp.write_text(json.dumps({"label": label, "expect": expect}) + "\n")
    os.replace(tmp, state / QUEUE_FILE)


def read_queue(state: Path) -> dict | None:
    path = state / QUEUE_FILE
    try:
        text = path.read_text()
    except FileNotFoundError:
        return None
    except OSError as e:
        raise LabError(f"cannot read {path}: {e}") from e
    try:
        q = json.loads(text)
        if not isinstance(q["label"], str) or not isinstance(q["expect"], str):
            raise TypeError
    except (ValueError, KeyError, TypeError) as e:
        raise LabError(f"{path} is not a valid queue; remove it") from e
    return q


def _verdict(path: Path) -> str:
    lines = path.read_text(errors="replace").splitlines()
    return "FAIL" if any(line.startswith("FAIL ") for line in lines) else "PASS"


def prev_boot_id(boots_text: str, this_boot: str) -> str | None:
    """boot= of the last boots.log line, unless there is none or it is this boot."""
    recs = parse_boots(boots_text)
    last = recs[-1].get("boot") if recs else None
    return last if last and last != this_boot else None


def boot_run(state: Path, ident: dict, prev_tail: str | None, cur_journal: str,
             pstore_n: int, run_g0, preflight=None) -> str:
    """Log this boot; run the queued g0 if the expected kernel booted.

    ident keys: boot_id, kver, cand ('package' or a candidate), build, stack, mode.
    run_g0(out_path) appends the checker's output to out_path. preflight() runs
    before anything is written for a run and may raise LabError (missing helper).
    The queue is consumed before run_g0, so a rung runs at most once: a reset or
    error mid-run never repeats it on a later boot."""
    prev = classify_prev_boot(prev_tail, cur_journal)
    state.mkdir(parents=True, exist_ok=True)
    with open(state / BOOTS_LOG, "a") as f:
        f.write(f"boot={ident['boot_id']} kver={ident['kver']} cand={ident['cand']} "
                f"build={ident['build']} mode={ident['mode']} prev={prev} "
                f"pstore={pstore_n}\n")
    q = read_queue(state)
    if q is None:
        return "logged"
    if not queue_matches(q["expect"], ident["cand"]):
        return (f"queued {q['label']} expects {q['expect']}, "
                f"booted {ident['cand']}; kept")
    if q["label"] != "g0":
        raise LabError("only g0 runs at boot")
    if preflight is not None:
        preflight()
    out = state / f"{q['label']}-{ident['kver']}-{ident['boot_id'][:8]}.txt"
    out.write_text(f"# kver={ident['kver']} cand={ident['cand']} build={ident['build']} "
                   f"stack={ident['stack']} mode={ident['mode']} prev={prev}\n")
    (state / QUEUE_FILE).unlink()
    run_g0(out)
    verdict = _verdict(out)
    return f"ran {q['label']} -> {out} ({verdict})"


def _journal(*args: str) -> str | None:
    """journalctl stdout, or None if it fails or prints nothing."""
    try:
        r = subprocess.run(["journalctl", *args, "-o", "cat"], capture_output=True,
                           text=True, errors="replace")
    except OSError:
        return None
    return r.stdout if r.returncode == 0 and r.stdout.strip() else None


def _gather_ident() -> dict:
    cand, build, stack = lab_identity(PROC_CMDLINE.read_text())
    try:
        mode = read_mode(PIN_CONF.read_text())
    except (OSError, LabError):
        mode = "?"
    return {"boot_id": BOOT_ID_PATH.read_text().strip().replace("-", ""),
            "kver": os.uname().release, "cand": cand or "package",
            "build": build or "-", "stack": stack or "-", "mode": mode}


def _run_g0(out: Path) -> None:
    """Append gpu-checks.sh g0 output to out; g0 exits 1 on any FAIL, which is fine."""
    checks = helper("gpu-checks.sh")
    with open(out, "a") as f:
        subprocess.run([str(checks), "g0"], stdout=f, stderr=subprocess.STDOUT)


def cmd_boot_run(args: argparse.Namespace) -> int:
    require_root("boot-run")
    try:
        try:
            pstore_n = len(list(PSTORE_DIR.iterdir()))
        except OSError:
            pstore_n = 0
        ident = _gather_ident()
        try:
            boots_text = (STATE_DIR / BOOTS_LOG).read_text()
        except OSError:
            boots_text = ""
        # after a cold reset this boot's clock starts at 1970, so trust our own log
        # over `journalctl -b -1` to name the previous boot
        pid = prev_boot_id(boots_text, ident["boot_id"])
        prev_tail = (_journal("-b", pid, "-n", "20") if pid else None) \
            or _journal("-b", "-1", "-n", "20")
        msg = boot_run(STATE_DIR, ident, prev_tail, _journal("-b") or "", pstore_n,
                       _run_g0, preflight=lambda: helper("gpu-checks.sh"))
    except Exception as e:  # noqa: BLE001 -- reported once, never retried
        print(f"erhai-lab: boot-run: {e}", file=sys.stderr)
        return 1
    print(msg)
    return 0


def cmd_queue(args: argparse.Namespace) -> int:
    require_root("queue")
    write_queue(STATE_DIR, args.label, args.expect)
    where = "the package kernel" if args.expect == "package" else f"lab kernel {args.expect}"
    print(f"queued {args.label}; it runs at the next boot of {where}")
    return 0


def status_report(state: Path, whoami: str, mode: str) -> str:
    out = [whoami, f"MODE={mode}"]
    try:
        q = read_queue(state)
    except LabError as e:
        out.append(f"queue: unreadable ({e})")
    else:
        out.append("queue: none" if q is None else f"queue: {q['label']} expects {q['expect']}")
    try:
        boots = (state / BOOTS_LOG).read_text().splitlines()
    except OSError:
        boots = []
    out.append("last boots:")
    out += [f"  {line}" for line in boots[-5:]] or ["  no boots logged"]
    files = []
    if state.is_dir():
        for pat in ("g*-*.txt", "power-*.txt"):
            files += [p for p in state.glob(pat) if p.is_file()]
    files = sorted(set(files), key=lambda p: (p.stat().st_mtime, p.name), reverse=True)[:5]
    out.append("evidence:")
    for p in files:
        lines = p.read_text(errors="replace").splitlines()
        npass = sum(1 for line in lines if line.startswith("PASS "))
        nfail = sum(1 for line in lines if line.startswith("FAIL "))
        out.append(f"  {p.name}  PASS={npass} FAIL={nfail}")
    if not files:
        out.append("  none")
    return "\n".join(out)


def cmd_status(args: argparse.Namespace) -> int:
    try:
        mode = read_mode(PIN_CONF.read_text())
    except (OSError, LabError):
        mode = "?"
    print(status_report(STATE_DIR, whoami_line(), mode))
    return 0


# ----------------------------------------------------------------- power ---

BASELINE_MW = 3639      # package kernel, MODE=once, 2026-10-28
POWER_INTERVAL_S = 10


def avg_discharge_mw(samples: list[tuple[int, int, int]]) -> float:
    """Mean battery power in mW of (epoch, voltage uV, current uA) samples.

    Current is negative while discharging; a sample at >= 0 means a charger
    (or no load) and the measurement is meaningless."""
    if not samples:
        raise LabError("no power samples")
    for epoch, _, current in samples:
        if current >= 0:
            raise LabError(f"charger connected (current_now >= 0 at {epoch}); "
                           "unplug and rerun")
    return sum(v * -i / 1e9 for _, v, i in samples) / len(samples)


def format_samples(samples: list[tuple[int, int, int]]) -> str:
    """`<epoch> <uV> <uA>` lines, the format of the idle-baseline evidence."""
    return "".join(f"{e} {v} {i}\n" for e, v, i in samples)


def sample_battery(count: int, battery: Path = BATTERY, sleep=time.sleep,
                   clock=lambda: int(time.time())) -> list[tuple[int, int, int]]:
    """Read voltage_now/current_now `count` times, POWER_INTERVAL_S apart.

    The epoch is only a label for the refusal message; nothing keys on it."""
    samples = []
    for n in range(count):
        if n:
            sleep(POWER_INTERVAL_S)
        try:
            v = int((battery / "voltage_now").read_text())
            i = int((battery / "current_now").read_text())
        except (OSError, ValueError) as e:
            raise LabError(f"cannot read {battery}: {e}") from e
        samples.append((clock(), v, i))
    return samples


def cmd_power(args: argparse.Namespace) -> int:
    require_root("power")
    if args.minutes < 0:
        raise LabError("--minutes must not be negative")
    kver = os.uname().release
    try:
        boot_id = PROC_BOOT_ID.read_text().strip()
    except OSError as e:
        raise LabError(f"cannot read {PROC_BOOT_ID}: {e}") from e
    count = args.minutes * 60 // POWER_INTERVAL_S
    print("Method: unplug the charger, screen on at a fixed brightness, Wi-Fi on, "
          "no apps running.")
    print(f"Sampling every {POWER_INTERVAL_S} s for {args.minutes} min ({count} samples)...",
          flush=True)
    samples = sample_battery(count)
    avg = avg_discharge_mw(samples)
    out = STATE_DIR / f"power-{kver}-{boot_id[:8]}.txt"
    try:
        STATE_DIR.mkdir(parents=True, exist_ok=True)
        out.write_text(format_samples(samples))
    except OSError as e:
        raise LabError(f"cannot write {out}: {e}") from e
    print(f"avg={avg:.0f} mW over {len(samples)} samples; baseline {BASELINE_MW} mW; "
          f"candidate <= baseline: {'yes' if avg <= BASELINE_MW else 'no'}")
    print(f"samples: {out}")
    return 0


# ------------------------------------------------------------------- cli ---

def require_root(what: str) -> None:
    if os.geteuid() != 0:
        raise LabError(f"{what} needs root; run it with sudo")


def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(prog="erhai-lab", description=__doc__,
                                formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = p.add_subparsers(dest="cmd", required=True)

    f = sub.add_parser("fetch", help="download, verify and install a lab kernel")
    f.add_argument("candidate")
    f.add_argument("--tag", help="exact release tag (default: latest for the candidate)")
    f.add_argument("--repo", default=REPO)
    f.add_argument("--verify-only", action="store_true",
                   help="download and verify, install nothing")
    f.set_defaults(func=cmd_fetch)

    sub.add_parser("whoami", help="which lab candidate is booted").set_defaults(func=cmd_whoami)
    sub.add_parser("setup", help="install g1 tools and build IGT (root)"
                   ).set_defaults(func=cmd_setup)
    m = sub.add_parser("mode", help="set the GPU pin policy and its services (root)")
    m.add_argument("mode", choices=MODES)
    m.set_defaults(func=cmd_mode)
    q = sub.add_parser("queue", help="queue a g0 check for the next boot (root)")
    q.add_argument("label")
    q.add_argument("--expect", required=True, metavar="CAND|package",
                   help="kernel that must be booted for the rung to run")
    q.set_defaults(func=cmd_queue)
    sub.add_parser("boot-run", help="log this boot, run the queued g0 (root, boot service)"
                   ).set_defaults(func=cmd_boot_run)
    sub.add_parser("status", help="mode, queue, recent boots and evidence"
                   ).set_defaults(func=cmd_status)
    w = sub.add_parser("power", help="idle power vs the 3639 mW baseline (root)")
    w.add_argument("--minutes", type=int, default=30,
                   help="sampling duration (default: 30; one sample every 10 s)")
    w.set_defaults(func=cmd_power)
    return p


def main(argv: list[str] | None = None) -> int:
    args = build_parser().parse_args(argv)
    try:
        return args.func(args)
    except LabError as e:
        print(f"erhai-lab: {e}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    sys.exit(main())
