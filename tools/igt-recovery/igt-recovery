#!/bin/bash
# SPDX-License-Identifier: GPL-2.0-only
#
# g1 hang source: upstream IGT msm_recovery (igt-gpu-tools), pinned, built
# once on the tablet. No hang code of our own.
#
#   tools/igt-recovery/igt-recovery build              clone + build into $IGT_DIR
#                                                      (default /var/lib/erhai-gpu/igt;
#                                                      `sudo erhai-gpu-lab setup` does this)
#   sudo tools/igt-recovery/igt-recovery run [SUBTEST] one run, kernel log saved
#
# SUBTEST is gpu-fault (default: hw hang detection, one bad submit among 16,
# the other 15 must replay) or hangcheck (same with the error IRQ disabled, so
# the sw hangcheck timer fires). Exit: 0 PASS, 1 FAIL, 2 usage/setup.
set -u

IGT_REPO=https://gitlab.freedesktop.org/drm/igt-gpu-tools.git
IGT_TAG=v2.6
IGT_COMMIT=916c79cfb7675ca01607dcd821f8c49d4f633a6f

HERE=$(cd "$(dirname "$0")" && pwd)
IGT_DIR=${IGT_DIR:-/var/lib/erhai-gpu/igt}
BIN=$IGT_DIR/build/tests/msm/msm_recovery
EVIDENCE=${EVIDENCE:-/var/lib/erhai-gpu}

die() { echo "igt-recovery: $*" >&2; exit 2; }

build() {
	for t in git meson ninja; do
		command -v "$t" >/dev/null || die "$t missing; run tablet/setup.sh"
	done
	mkdir -p "$IGT_DIR"
	if [ ! -d "$IGT_DIR/src/.git" ]; then
		git clone -q --no-checkout "$IGT_REPO" "$IGT_DIR/src" || die "clone failed"
	fi
	git -C "$IGT_DIR/src" fetch -q --depth 1 origin "refs/tags/$IGT_TAG:refs/tags/$IGT_TAG" ||
		die "fetch $IGT_TAG failed"
	git -C "$IGT_DIR/src" checkout -q --detach "$IGT_COMMIT" || die "checkout failed"
	[ "$(git -C "$IGT_DIR/src" rev-parse HEAD)" = "$IGT_COMMIT" ] ||
		die "$IGT_TAG is not $IGT_COMMIT"
	if [ ! -d "$IGT_DIR/build" ]; then
		meson setup "$IGT_DIR/build" "$IGT_DIR/src" \
			-Dtests=enabled -Drunner=disabled -Doverlay=disabled \
			-Dman=disabled -Ddocs=disabled -Dtestplan=disabled \
			-Dchamelium=disabled -Dvalgrind=disabled \
			-Dlibunwind=disabled -Dxe_driver=disabled || die "meson setup failed"
	fi
	ninja -C "$IGT_DIR/build" tests/msm/msm_recovery || die "build failed"
	echo "igt-recovery: built $BIN ($IGT_TAG $IGT_COMMIT)"
}

# dump_check MARKER: does debugfs still produce a complete GPU dump, and was a
# complete devcoredump saved by the udev copier after MARKER? Prints one line
# dump=<...>; rc 0 for dump=ok (new .bin and debugfs both complete) and
# dump=debugfs-only (no new .bin). IGT's msm_recovery calls
# read_and_clear_devcore() itself: it reads /sys/class/devcoredump/devcd*/data
# within 1 s and frees it, racing our copier, which then may find the devcd
# gone. So a missing .bin is not a failure once $ERHAI_DUMP_WAIT_S has given
# the copier its chance; the debugfs check is the required one. A new .bin
# missing a section is still a failure (a truncated saved dump is a defect).
# The subcommand itself needs no root, but reading the real debugfs gpu file does.
dump_check() {
	local marker=$1 dir=${ERHAI_COREDUMP_DIR:-/var/lib/erhai-gpu/coredumps}
	local wait=${ERHAI_DUMP_WAIT_S:-30}
	local glob=${ERHAI_DEBUGFS_GPU_GLOB:-/sys/kernel/debug/dri/*/gpu}
	local newest="" i f sec pat
	for ((i = 0; ; i++)); do
		newest=$(find "$dir" -name '*.bin' -newer "$marker" -printf '%T@ %p\n' 2>/dev/null |
			sort -rn | head -n1 | cut -d' ' -f2-)
		[ -n "$newest" ] && break
		[ "$i" -ge "$wait" ] && break
		sleep 1
	done
	if [ -n "$newest" ]; then
		for sec in ringbuffer gmu-log gmu-hfi queue-history; do
			pat="^$sec:"
			[ "$sec" = queue-history ] && pat='queue-history\['
			grep -aq -- "$pat" "$newest" || { echo "dump=incomplete:$sec"; return 1; }
		done
	fi
	f=""
	for i in $glob; do
		[ -r "$i" ] && [ -f "$i" ] && { f=$i; break; }
	done
	[ -n "$f" ] || { echo "dump=incomplete:debugfs"; return 1; }
	local txt
	txt=$(cat "$f" 2>/dev/null) || { echo "dump=incomplete:debugfs"; return 1; }
	for sec in ringbuffer gmu-log gmu-hfi queue-history; do
		pat="^$sec:"
		[ "$sec" = queue-history ] && pat='queue-history\['
		grep -aq -- "$pat" <<<"$txt" || { echo "dump=incomplete:debugfs-$sec"; return 1; }
	done
	if [ -n "$newest" ]; then echo "dump=ok"; else echo "dump=debugfs-only"; fi
}

run() {
	local sub=$1
	[ "$(id -u)" = 0 ] || die "run needs root (debugfs, devcoredump)"
	[ -x "$BIN" ] || die "$BIN missing; run: tools/igt-recovery/igt-recovery build"
	mkdir -p "$EVIDENCE"
	local ts out since rc marker
	ts=$(date +%Y%m%d-%H%M%S)
	out=$EVIDENCE/g1-$sub-$ts.txt
	since=$(date '+%Y-%m-%d %H:%M:%S')
	echo "igt-recovery: $sub at $since, kernel $(uname -r), control=$(cat /sys/devices/platform/soc@0/3d00000.gpu/power/control 2>/dev/null)"
	marker=$EVIDENCE/.g1-marker-$ts
	touch "$marker"
	timeout 120 "$BIN" --run-subtest "$sub"
	rc=$?
	sleep 3
	journalctl -k --since "$since" --no-pager >"$out" 2>&1

	local rec cx hw dump=n/a
	if [ "$sub" = gpu-fault ]; then
		dump=$(dump_check "$marker")
		dump=${dump#dump=}
	fi
	rm -f "$marker"
	rec=$(grep -c 'hangcheck recover!' "$out")
	cx=$(grep -c "cx gdsc didn't collapse" "$out")
	hw=$(grep -ciE 'hw_init.*fail|failed to (re)?init|Couldn.t power up the GPU' "$out")
	echo "igt-recovery: subtest=$sub igt_rc=$rc recover=$rec cx_not_collapsed=$cx hw_init_errors=$hw dump=$dump log=$out"
	if [ "$rc" = 0 ] && [ "$rec" = 1 ] && [ "$cx" = 0 ] && [ "$hw" = 0 ] &&
	   { [ "$sub" != gpu-fault ] || [ "$dump" = ok ] || [ "$dump" = debugfs-only ]; }; then
		echo "PASS g1 $sub"
		return 0
	fi
	want="igt_rc=0 recover=1 cx_not_collapsed=0 hw_init_errors=0"
	[ "$sub" = gpu-fault ] && want="$want dump=ok|debugfs-only"
	echo "FAIL g1 $sub (want $want)"
	return 1
}

case "${1:-}" in
build) build ;;
run)
	sub=${2:-gpu-fault}
	case "$sub" in
	gpu-fault|hangcheck) run "$sub" ;;
	*) die "unknown subtest '$sub' (gpu-fault|hangcheck)" ;;
	esac
	;;
dump-check)
	[ -n "${2:-}" ] || die "usage: $0 dump-check <marker-file>"
	dump_check "$2"
	;;
*) echo "usage: $0 build | run [gpu-fault|hangcheck] | dump-check <marker>" >&2; exit 2 ;;
esac
