From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Nico Angelo Dela Cruz <nicoangelodelacruz@gmail.com>
Date: Sun, 1 Nov 2026 21:04:44 +0800
Subject: [PATCH] LAB ONLY: drm/msm: log crash state capture durations

Not for upstream; input for the bounded-wait RFC (lab TODOS).

Signed-off-by: Nico Angelo Dela Cruz <nicoangelodelacruz@gmail.com>
---
 drivers/gpu/drm/msm/msm_gpu.c | 8 ++++++++
 1 file changed, 8 insertions(+)

diff --git a/drivers/gpu/drm/msm/msm_gpu.c b/drivers/gpu/drm/msm/msm_gpu.c
index 428dc966682..2b6e3ef19eb 100644
--- a/drivers/gpu/drm/msm/msm_gpu.c
+++ b/drivers/gpu/drm/msm/msm_gpu.c
@@ -494,6 +494,7 @@ static void recover_worker(struct kthread_work *work)
 	char *comm = NULL, *cmd = NULL;
 	unsigned int noreclaim_flag;
 	struct task_struct *task;
+	ktime_t start;
 	int i;
 
 	mutex_lock(&gpu->lock);
@@ -551,7 +552,10 @@ static void recover_worker(struct kthread_work *work)
 
 	/* Record the crash state */
 	pm_runtime_get_sync(&gpu->pdev->dev);
+	start = ktime_get();
 	msm_gpu_crashstate_capture(gpu, submit, NULL, comm, cmd);
+	dev_info(gpu->dev->dev, "erhai-lab: crashstate capture (%s) took %lld us\n",
+		 "recover", ktime_us_delta(ktime_get(), start));
 
 	memalloc_noreclaim_restore(noreclaim_flag);
 
@@ -621,6 +625,7 @@ void msm_gpu_fault_crashstate_capture(struct msm_gpu *gpu, struct msm_gpu_fault_
 	struct msm_ringbuffer *cur_ring = gpu->funcs->active_ring(gpu);
 	char *comm = NULL, *cmd = NULL;
 	unsigned int noreclaim_flag;
+	ktime_t start;
 
 	mutex_lock(&gpu->lock);
 
@@ -642,7 +647,10 @@ void msm_gpu_fault_crashstate_capture(struct msm_gpu *gpu, struct msm_gpu_fault_
 
 	/* Record the crash state */
 	pm_runtime_get_sync(&gpu->pdev->dev);
+	start = ktime_get();
 	msm_gpu_crashstate_capture(gpu, submit, fault_info, comm, cmd);
+	dev_info(gpu->dev->dev, "erhai-lab: crashstate capture (%s) took %lld us\n",
+		 "fault", ktime_us_delta(ktime_get(), start));
 	pm_runtime_put_sync(&gpu->pdev->dev);
 
 	memalloc_noreclaim_restore(noreclaim_flag);
